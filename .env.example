# SaaS deployment: use a dedicated PostgreSQL database for this product.
# Local-only SQLite example: file:../database/sunfzenith-saas-dev.db
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sunfzenith_saas?sslmode=require"
JWT_SECRET="replace_with_a_unique_random_secret_of_at_least_32_characters"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PRODUCT_VARIANT="saas"

# Optional existing queue and branding settings
NEXT_PUBLIC_QUEUE_PREFIX="Q"
NEXT_PUBLIC_SHOP_NAME="SUNFZENITH Queue SaaS"

# Payment gateway and email credentials are intentionally absent until real providers are configured.
