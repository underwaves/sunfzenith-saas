{
  "name": "sunfzenith-saas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "node scripts/patch-prisma.js && prisma generate && next build",
    "start": "next start -p 3002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/patch-prisma.js && tsx --test tests/**/*.test.ts",
    "test:ui": "node scripts/test-ui-viewport.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset-demo": "node scripts/reset-demo-db.js",
    "postinstall": "node scripts/patch-prisma.js && prisma generate",
    "build:worker": "node scripts/patch-prisma.js && prisma generate && opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/adapter-pg": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.5",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/pg": "^8.11.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "postcss": "$postcss"
  }
}
